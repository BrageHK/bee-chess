# Rust
# One shared target/ at the repo root, not /engine/target/, since
# engine/ and lab/ are both members of the root Cargo workspace.
/target/
# mamba_mcts_native is deliberately its own workspace (see its Cargo.toml),
# so it builds into its own target/ instead of the shared one above.
/mamba_mcts_native/target/

# Bee Lab
# Persisted finished-game history (#123) -- runtime data, not source.
/data/lab/

# bee-games / game-catalog
# The local SQLite catalog `bee-games` syncs into by default -- runtime
# data, not source.
/data/games/

# Python
/training/.venv/
/training/.pytest_cache/
/training/.ruff_cache/
/training/.cache/
/training/data/
/training/books/
/training/checkpoints/
/training/logs/
/bridge/.venv/
/bridge/.pytest_cache/
/bridge/.ruff_cache/
__pycache__/
*.pyc

# Node
node_modules/
dist/
dist-ssr/

# Editor / OS
.DS_Store
.vscode/
*.code-workspace
.idea/
